# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your-region

# Example of what filled-in values look like. These are NOT real credentials —
# they are obvious placeholders for visual reference only. Replace every one:
# B2_APPLICATION_KEY_ID=EXAMPLE_ONLY_replace_with_your_keyID
# B2_APPLICATION_KEY=EXAMPLE_ONLY_replace_with_your_applicationKey
# B2_BUCKET_NAME=my-curation-corpora
# B2_REGION=us-west-004
#
# The S3 endpoint is derived from B2_REGION as
#   https://s3.<B2_REGION>.backblazeb2.com
# so you only set the region, never a full endpoint URL.

# Optional: public base URL for building browser-facing object URLs when the
# bucket is public (e.g. https://my-bucket.s3.us-west-004.backblazeb2.com or a
# CDN origin). Leave unset for a private bucket — the app runs without it.
# B2_PUBLIC_URL_BASE=

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
