  "info": {
    "description": "Multi-stage LLM training-data curation (dedup, quality, PII) with versioned stage outputs on Backblaze B2",
    "title": "NeMo Curator Training Data API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/files": {
      "get": {
        "operationId": "list_files_endpoint_files_get",
        "parameters": [
          {
            "in": "query",
            "name": "prefix",
            "required": false,
            "schema": {
              "default": "",
              "title": "Prefix",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FileMetadata"
                  },
                  "title": "Response List Files Endpoint Files Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Files Endpoint",
        "tags": [
          "files"
        ]
      }
    },
    "/files-by-key": {
      "delete": {
        "operationId": "delete_file_by_key_endpoint_files_by_key_delete",
        "parameters": [
          {
            "in": "query",
            "name": "key",
            "required": true,
            "schema": {
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete File By Key Endpoint",
        "tags": [
          "files"
        ]
      }
    },
    "/files-by-key/detail": {
      "get": {
        "description": "Rich metadata (checksums, image/PDF fields) recomputed on demand.\n\nUnlike /metadata (a cheap head_object), this downloads the object to\nre-run extraction, so it is billed at the tighter 'write' rate-limit tier\n(see runtime/ratelimit.py) to bound egress/cost amplification.",
        "operationId": "get_file_detail_by_key_endpoint_files_by_key_detail_get",
        "parameters": [
          {
            "in": "query",
            "name": "key",
            "required": true,
            "schema": {
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileMetadataDetail"
                }
